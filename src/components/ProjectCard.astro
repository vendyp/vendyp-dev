---
interface Props {
  title: string;
  role: string;
  duration: string;
  excerpt: string;
  tags: readonly string[];
  href?: string;
}

const { title, role, duration, excerpt, tags, href = "#" } = Astro.props;
---

<article class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_-12px_rgba(47,128,237,0.10)] md:items-center md:p-8 md:pb-6">
  <div class="flex-1 md:pr-6">
    <div class="space-y-2.5">
      <h4 class="text-xl font-bold text-navy">{title}</h4>
      <div class="flex items-center gap-2 text-sm text-gray-500">
        {role}
        <span class="mx-1">•</span>
        {duration}
      </div>
      <p class="text-sm leading-relaxed text-gray-600">{excerpt}</p>
      <div class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <span class="rounded-full bg-blue-light px-3 py-1 text-sm text-gray-600">{tag}</span>
          ))
        }
      </div>
    </div>
  </div>
  <div class="mt-6 flex w-full items-center border-t border-gray-100 pt-4">
    <a href={href} class="group/link relative flex w-full items-center justify-between text-sm font-medium text-coral transition-all duration-200">
      View Case
      <span class="ml-1 inline-block transition-transform duration-200 group-hover/link:translate-x-1">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 18h12" stroke="#2F80ED" stroke-width="3" stroke-linecap="round"></path>
          <path d="M24 18l-4.5-4.5" stroke="#2F80ED" stroke-width="3" stroke-linecap="round"></path>
          <path d="M24 18l-4.5 4.5" stroke="#2F80ED" stroke-width="3" stroke-linecap="round"></path>
        </svg>
      </span>
    </a>
  </div>
</article>
