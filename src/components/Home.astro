---
import { companyLogos } from "../data/site";
---

<section
    id="about"
    class="fade-in bg-linear-to-br from-blob-a via-white to-blue-light pt-32 pb-20 md:pt-40 md:pb-32"
>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div
            class="flex flex-col-reverse items-center gap-12 md:flex-row md:gap-16"
        >
            <div
                class="z-10 flex flex-1 flex-col items-start text-center md:text-left"
            >
                <span
                    class="mb-6 inline-block rounded-full bg-blob-a px-4 py-1.5 text-sm font-bold uppercase tracking-wide text-coral shadow-sm"
                >
                    Senior Software Engineer
                </span>
                <h1
                    class="mb-6 text-5xl leading-[1.1] font-extrabold text-navy md:text-6xl lg:text-7xl"
                >
                    Building <span class="text-coral">Smart</span> Digital Solutions
                </h1>
                <p
                    class="mb-10 max-w-xl text-lg leading-relaxed text-body md:text-xl"
                >
                    Software engineer with 8+ years of experience building
                    scalable systems and elegant solutions. Passionate about
                    clean architecture and developer experience.
                </p>
                <div
                    class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row"
                >
                    <a
                        href="/projects"
                        class="flex w-full items-center justify-center gap-2 rounded-full bg-coral px-8 py-4 font-bold text-white shadow-xl shadow-blue-200 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-300 sm:w-auto"
                    >
                        View Projects
                        <svg
                            class="h-5 w-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a
                        href="#skills"
                        class="flex w-full items-center justify-center rounded-full border-2 border-blue-light bg-white px-8 py-4 font-bold text-navy transition-all duration-300 hover:border-coral hover:text-coral sm:w-auto"
                    >
                        My Skills
                    </a>
                </div>
                <div
                    class="list-companys mt-12 flex items-center gap-8 opacity-60 grayscale transition-all duration-500 hover:grayscale-0"
                >
                    {
                        companyLogos.map((logo) => (
                            <span class="text-xl font-bold">{logo}</span>
                        ))
                    }
                </div>
            </div>

            <div
                class="relative flex w-full flex-1 justify-center md:justify-end"
            >
                <div class="relative h-80 w-[320px] md:h-112.5 md:w-112.5">
                    <div
                        class="animate-float absolute top-0 right-0 h-full w-full scale-110 rounded-[60%_40%_30%_70%/60%_30%_70%_40%] bg-blob-a opacity-60 blur-xl"
                    >
                    </div>
                    <div
                        class="animate-float-delayed absolute top-10 right-10 h-full w-full scale-90 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] bg-blob-2 opacity-20 blur-xl"
                    >
                    </div>
                    <div
                        class="relative z-10 h-full w-full rotate-3 overflow-hidden rounded-[40px] border-8 border-white shadow-2xl shadow-blue-100/50 transition-transform duration-500 hover:rotate-0"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&h=800&fit=crop&crop=face"
                            alt="Dwi Vendy portrait"
                            class="h-full w-full object-cover"
                        />
                    </div>
                    <div
                        class="animate-float absolute top-20 -left-8 z-20 flex max-w-50 items-center gap-3 rounded-2xl bg-white p-4 shadow-xl shadow-slate-200/50"
                    >
                        <div
                            class="flex h-10 w-10 items-center justify-center rounded-full bg-blob-a text-coral"
                        >
                            <svg
                                class="h-5 w-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 20l4-16m4 4l4 4m-4-4l-4 4"></path>
                            </svg>
                        </div>
                        <div>
                            <p
                                class="text-xs font-semibold uppercase text-gray-400"
                            >
                                Experience
                            </p>
                            <p class="text-sm font-bold text-navy">8+ Years</p>
                        </div>
                    </div>
                    <div
                        class="animate-float-delayed absolute -right-4 bottom-20 z-20 flex items-center gap-3 rounded-2xl bg-white p-4 shadow-xl shadow-slate-200/50"
                    >
                        <div
                            class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-light text-coral"
                        >
                            <svg
                                class="h-5 w-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 9l-3 3m0 0l3 3m-3-3h12a3 3 0 000-6H5a3 3 0 000 6h12"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <p
                                class="text-xs font-semibold uppercase text-gray-400"
                            >
                                Code Written
                            </p>
                            <p class="text-sm font-bold text-navy">
                                2.5M+ Lines
                            </p>
                        </div>
                    </div>
                    <div
                        class="animate-float absolute -bottom-6 left-10 z-20 rounded-xl bg-navy px-5 py-3 text-white shadow-xl shadow-navy/30"
                    >
                        <div class="flex items-center gap-2">
                            <div
                                class="h-2 w-2 animate-pulse rounded-full bg-coral"
                            >
                            </div>
                            <span class="text-sm font-bold">Open to work</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
