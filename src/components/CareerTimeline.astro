---
import { experiences } from "../data/experiences";
---

<section id="experience" class="fade-in px-4 py-20 sm:px-6 md:py-28">
    <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
            <span
                class="mb-2 block text-sm font-bold uppercase tracking-wider text-coral"
                >Career Path</span
            >
            <h3 class="text-3xl font-extrabold text-navy md:text-4xl">
                Work Experience
            </h3>
        </div>
        <div class="relative mx-auto max-w-4xl">
            <div
                class="absolute top-0 bottom-0 left-8 hidden w-1 rounded-full bg-blob-a md:block"
            >
            </div>
            <div class="space-y-12">
                {
                    experiences.map((experience) => (
                        <div class="group relative md:pl-24">
                            <div class="absolute top-8 left-6.5 z-10 hidden h-5 w-5 rounded-full border-4 border-blob-a bg-coral shadow-lg transition-transform duration-300 group-hover:scale-125 md:block" />
                            <div class="relative overflow-hidden rounded-3xl border border-blue-100/50 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/10">
                                <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-bl-[100px] bg-blob-a opacity-50 transition-transform duration-500 group-hover:scale-110" />
                                <div class="relative z-10 mb-4 flex flex-col justify-between md:flex-row md:items-center">
                                    <div class="mb-2 flex items-center gap-3 md:mb-0">
                                        <h4 class="text-xl font-bold text-navy">
                                            {experience.title}
                                        </h4>
                                    </div>
                                    <span class="inline-block rounded-full border border-blob-a bg-blob-a px-4 py-1 text-sm font-bold text-coral">
                                        {experience.period}
                                    </span>
                                </div>
                                <div class="relative z-10 mb-4 text-lg font-semibold text-coral">
                                    {experience.company}
                                </div>
                                <p class="relative z-10 leading-relaxed text-body">
                                    {experience.description}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
