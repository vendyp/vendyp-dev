---
import { siteMeta } from "../data/metadata";
import { navLinks } from "../data/site";

interface Props {
  active?: "about" | "post" | "project";
}

const { active } = Astro.props;
---

<nav
  id="navbar"
  class="navbar-scroll fixed top-0 left-0 right-0 z-50 bg-transparent py-4 transition-all duration-300"
>
  <div class="container mx-auto px-5">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="text-2xl font-extrabold tracking-tight text-navy transition-colors hover:text-coral"
      >
        Vendy<span class="text-coral">.</span>
      </a>

      <div
        id="nav-menu"
        class="absolute top-20 left-0 right-0 z-40 flex max-h-0 w-full flex-col items-start overflow-hidden rounded-b-lg bg-white p-4 shadow-lg transition-all duration-300 md:static md:top-auto md:left-auto md:right-auto md:max-h-none md:w-auto md:flex-row md:items-center md:space-y-0 md:space-x-8 md:overflow-visible md:rounded-none md:bg-transparent md:p-0 md:shadow-none"
      >
        {
          navLinks.map((link) => {
            const isActive = active === link.key;

            return (
              <a
                href={link.href}
                class:list={[
                  "group relative block w-full text-base font-medium transition-colors md:inline md:w-auto",
                  isActive
                    ? "font-bold text-coral"
                    : "text-navy hover:text-coral",
                ]}
              >
                {link.label}
                <span
                  class:list={[
                    "absolute -bottom-1 left-0 hidden h-0.5 bg-coral transition-all md:block",
                    isActive ? "w-full" : "w-0 group-hover:w-full",
                  ]}
                />
              </a>
            );
          })
        }
      </div>

      <div class="flex items-center justify-between gap-4">
        <a
          href={`mailto:${siteMeta.email}`}
          class="rounded-full bg-coral px-6 py-2.5 font-semibold text-white shadow-lg shadow-blue-200 transition-all duration-300 hover:shadow-blue-300"
        >
          Get in Touch
        </a>

        <button
          id="mobile-menu-btn"
          class="h-10 w-10 rounded-full bg-white transition-all duration-300 focus:outline-none md:hidden"
          aria-label="Open navigation"
          type="button"
        >
          <svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            style="margin-left: 4px;"
          >
            <path
              d="M5 8H13.75M5 12H19M10.25 16H19"
              stroke="#1B1B4E"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>
