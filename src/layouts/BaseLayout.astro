---
import "../styles/global.css";

const { title = "vendyp.dev" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <nav class="sticky top-0 bg-white shadow">
            <ul class="flex justify-center gap-8 p-4">
                <li><a href="/posts" class="hover:text-blue-600">Posts</a></li>
                <li><a href="/" class="hover:text-blue-600">Home</a></li>
                <li><a href="/projects" class="hover:text-blue-600">Projects</a></li>
            </ul>
        </nav>

		<slot />
    </body>
</html>
