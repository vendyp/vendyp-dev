---
import { featuredProject } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title={`Project Details - ${featuredProject.title}`} activeNav="project" showCircleTop={true}>
  <main class="px-4 pt-32 pb-20 sm:px-6 md:pt-40 md:pb-32">
    <div class="mx-auto max-w-195">
      <section class="fade-in mb-10">
        <h1 class="mb-5 text-2xl leading-relaxed font-extrabold text-navy md:text-4xl">{featuredProject.title}</h1>
        <div class="mb-3 flex flex-wrap items-center gap-2">
          {featuredProject.tags.slice(2).concat(featuredProject.tags.slice(0, 2)).map((tag) => <span class="rounded-full bg-blue-light px-3 py-1 text-sm text-gray-600">{tag}</span>)}
        </div>
        <div class="mb-3 flex flex-wrap items-center gap-4 text-sm text-gray-500">
          <span>Role: <span class="font-semibold text-navy">{featuredProject.role}</span></span>
          <span>Duration: {featuredProject.duration}</span>
        </div>
        <p class="text-lg leading-relaxed text-gray-600">{featuredProject.summary}</p>
      </section>
      <section class="fade-in mb-10 pt-8">
        <h2 class="mb-3 text-2xl font-bold text-navy">Project Overview</h2>
        <div class="space-y-2">
          {featuredProject.overview.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="list-disc space-y-1.5 pl-6 text-gray-700">
            {featuredProject.overviewPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
      <section class="fade-in mb-10 border-t border-black/5 pt-8">
        <h2 class="mb-3 text-2xl font-bold text-navy">Highlighted Features</h2>
        <ul class="list-disc space-y-1.5 pl-6 text-gray-700">
          {featuredProject.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </section>
      <section class="fade-in mb-10 border-t border-black/5 pt-8">
        <h2 class="mb-3 text-2xl font-bold text-navy">My Role</h2>
        <ul class="list-disc space-y-1.5 pl-6 text-gray-700">
          {featuredProject.responsibilities.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section class="fade-in mb-10 border-t border-black/5 pt-8">
        <h2 class="mb-3 text-2xl font-bold text-navy">Tech Stack</h2>
        <div class="flex flex-wrap gap-2">
          {featuredProject.techStack.map((item) => <span class="rounded-full bg-blue-light px-3 py-1 text-sm text-gray-600">{item}</span>)}
        </div>
      </section>
      <section class="fade-in border-t border-black/5 pt-8">
        <h2 class="mb-6 text-2xl font-bold text-navy">Project Preview</h2>
        <div class="grid gap-5">
          {
            featuredProject.previews.map((preview) => (
              <img
                src={preview.src}
                alt={preview.alt}
                class="h-48 w-full rounded-2xl object-cover sm:h-64 md:h-80 lg:h-96"
              />
            ))
          }
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
