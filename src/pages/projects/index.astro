---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Project List" activeNav="project">
  <main>
    <section id="experience" class="fade-in px-4 py-20 sm:px-6 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <span
            class="mb-2 block text-sm font-bold uppercase tracking-wider text-coral"
            >Project List</span
          >
          <h3 class="text-3xl font-extrabold text-navy md:text-4xl">
            Projects
          </h3>
          <p class="mx-auto mt-3 max-w-2xl text-body">
            A concise, vertical list of selected projects. Each entry includes
            role, duration, a short description, subtle highlights, and a link
            to the case.
          </p>
        </div>
        <div class="mx-auto max-w-4xl">
          <div class="card-post border-0 bg-transparent px-6 py-12 text-center">
            <h4 class="text-xl font-bold text-navy">No projects added yet</h4>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
